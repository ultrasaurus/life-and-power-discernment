
{{> _navbar }}
<div class="topspacer"></div>
<div class="w3-container section-highlight reference">
    <div class="section-content">

        <!-- highlight area -->
        {{#each (split title)}}
        <h1>{{ this }}</h1>
        {{/each}}

        <p style="text-align:center;font-size: 1.2rem"><b>{{intro-heading}}</b>{{intro-text}}</p>
        {{#if author}}
        <div class="author">by {{person author}}
        </div>
        {{/if}}
    </div>
</div>

<div class="section-content section-light reference">
        {{{ body }}}
</div>
